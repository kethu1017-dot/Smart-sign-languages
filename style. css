*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f5f3ff;color:#202040}header{min-height:72px;background:linear-gradient(135deg,#3226c8,#6131df,#9a42ef);color:white;display:flex;justify-content:space-between;align-items:center;padding:10px 20px}.brand{display:flex;gap:12px;align-items:center}.logo{background:white;color:#5b35d5;border-radius:14px;padding:10px;font-size:25px}.brand h1{font-size:20px;margin:0}.brand p{margin:4px 0;font-size:12px}.layout{display:flex;min-height:calc(100vh - 72px)}aside{width:220px;background:white;padding:15px;box-shadow:2px 0 10px #ddd}aside button{display:block;width:100%;margin:7px 0;padding:12px;border:0;border-radius:10px;text-align:left;background:white;cursor:pointer}.active,.nav:hover{background:#eee9ff!important;color:#5931d4;font-weight:bold}main{flex:1;padding:28px;max-width:1200px;margin:auto}.page{display:none}.page.active{display:block}.hero{background:linear-gradient(135deg,#3226c8,#6131df,#9a42ef);color:white;border-radius:22px;padding:45px;text-align:center}.hero h2{font-size:36px}.chips{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:20px}.chips span{border:1px solid #ffffff66;padding:8px 15px;border-radius:20px}.primary{background:#6131df!important;color:white!important}.hero .primary{background:white!important;color:#5931d4!important}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}.cards>div,.result{background:white;border-radius:16px;padding:20px;box-shadow:0 5px 18px #32267a12;cursor:pointer}.cards b{font-size:30px}.flow{background:white;margin-top:20px;padding:18px;border-radius:14px;text-align:center}.camera{position:relative;max-width:800px;margin:20px auto;background:#111;border-radius:15px;overflow:hidden}.camera video,.camera canvas{width:100%;display:block}.camera canvas{position:absolute;left:0;top:0}button,select{padding:10px 14px;border:0;border-radius:9px;margin:5px;cursor:pointer}textarea{width:100%;padding:14px;border:1px solid #ddd;border-radius:12px;font-size:16px}#uploadedVideo{width:100%;max-width:800px;margin-top:15px;border-radius:15px}#gestureResult{font-size:30px;font-weight:bold;color:#6131df}#signOutput{font-size:30px;min-height:60px}@media(max-width:750px){.layout{display:block}aside{width:100%;display:flex;overflow:auto}aside button{min-width:135px}.cards{grid-template-columns:1fr}.hero{padding:28px}.hero h2{font-size:28px}.brand h1{font-size:15px}}
