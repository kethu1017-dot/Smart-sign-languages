* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f3ff;
    color: #202040;
}

.topbar {
    min-height: 76px;
    background: linear-gradient(135deg, #3226c8, #6131df, #9a42ef);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 22px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo {
    width: 50px;
    height: 50px;
    border-radius: 15px;
    background: white;
    color: #6131df;
    display: grid;
    place-items: center;
    font-size: 28px;
}

.brand h1 {
    font-size: 20px;
}

.brand p {
    opacity: .85;
    font-size: 13px;
    margin-top: 3px;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.top-actions select {
    padding: 9px 12px;
    border: 0;
    border-radius: 10px;
}

.home-btn {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    background: white;
    color: #6131df;
    font-size: 20px;
}

.app-layout {
    display: flex;
    min-height: calc(100vh - 76px);
}

.sidebar {
    width: 230px;
    background: white;
    padding: 20px 14px;
    box-shadow: 2px 0 12px rgba(0,0,0,.06);
}

.nav-btn {
    width: 100%;
    padding: 13px;
    margin-bottom: 10px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    font-size: 15px;
}

.nav-btn:hover,
.nav-btn.active {
    background: #eee9ff;
    color: #5b31d6;
    font-weight: bold;
}

.content {
    flex: 1;
    padding: 28px;
    max-width: 1200px;
    margin: auto;
}

.page {
    display: none;
}

.active-page {
    display: block;
}

.hero {
    background: linear-gradient(135deg, #3226c8, #6131df, #9a42ef);
    color: white;
    border-radius: 24px;
    padding: 45px 35px;
    text-align: center;
}

.hero-badge {
    display: inline-block;
    background: rgba(255,255,255,.18);
    padding: 7px 14px;
    border-radius: 30px;
    font-size: 12px;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.hero h2 {
    font-size: 36px;
    margin-bottom: 12px;
}

.hero p {
    max-width: 650px;
    margin: auto;
    line-height: 1.6;
}

.chips {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 22px 0;
    flex-wrap: wrap;
}

.chips span {
    padding: 8px 15px;
    border: 1px solid rgba(255,255,255,.4);
    border-radius: 30px;
}

.primary-btn,
.secondary-btn,
.voice-btn {
    border: 0;
    border-radius: 11px;
    padding: 11px 16px;
    cursor: pointer;
    font-weight: bold;
    margin: 5px;
}

.primary-btn {
    background: #6b38e8;
    color: white;
}

.hero .primary-btn {
    background: white;
    color: #5c30d4;
}

.secondary-btn {
    background: #e9e4ff;
    color: #4e2db6;
}

.voice-btn {
    background: #dff7e9;
    color: #146b3a;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 24px;
}

.card,
.status-card,
.result-card,
.training-box {
    background: white;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 5px 20px rgba(50,38,120,.08);
}

.card {
    cursor: pointer;
}

.card-icon {
    font-size: 32px;
    margin-bottom: 12px;
}

.card h3 {
    margin-bottom: 8px;
}

.card p {
    color: #666;
    line-height: 1.5;
}

.flow {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 25px 0;
    align-items: center;
}

.flow span {
    background: white;
    padding: 12px 16px;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(0,0,0,.06);
}

.section-title {
    margin-bottom: 20px;
}

.section-title h2 {
    font-size: 30px;
    margin-bottom: 7px;
}

.section-title p {
    color: #666;
}

.camera-controls {
    margin-bottom: 15px;
}

.camera-box {
    position: relative;
    width: 100%;
    max-width: 800px;
    min-height: 300px;
    margin: 10px auto 20px;
    background: #111;
    border-radius: 18px;
    overflow: hidden;
}

#cameraVideo,
#cameraCanvas {
    width: 100%;
    display: block;
}

#cameraCanvas {
    position: absolute;
    left: 0;
    top: 0;
}

.status-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin: 20px 0;
}

.status-card {
    display: flex;
    justify-content: space-between;
}

.status-card strong {
    color: #5c30d4;
}

.result-card,
.training-box {
    margin-top: 18px;
}

.result-card h3,
.training-box h3 {
    margin-bottom: 12px;
}

#gestureResult {
    font-size: 28px;
    font-weight: bold;
    color: #5c30d4;
}

#tamilResult {
    margin-top: 7px;
    color: #555;
}

.training-box select,
#videoInput {
    padding: 10px;
    margin: 5px;
    border-radius: 9px;
    border: 1px solid #ddd;
}

.video-preview {
    margin-top: 20px;
    max-width: 800px;
}

#uploadedVideo {
    width: 100%;
    border-radius: 18px;
    background: #111;
}

textarea {
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 15px;
    padding: 15px;
    font-size: 16px;
    resize: vertical;
}

.text-controls {
    margin: 12px 0;
}

.sign-output {
    min-height: 80px;
    padding: 15px;
    font-size: 30px;
}

@media (max-width: 800px) {
    .app-layout {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        display: flex;
        overflow-x: auto;
        gap: 8px;
        padding: 10px;
    }

    .nav-btn {
        min-width: 140px;
        margin: 0;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .status-grid {
        grid-template-columns: 1fr;
    }

    .hero h2 {
        font-size: 27px;
    }

    .brand h1 {
        font-size: 16px;
    }
}
